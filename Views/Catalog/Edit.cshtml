@model EditProductViewModel
@{
    ViewData["Title"] = "Edit Produk";
    var code = ViewData["ProductCode"]?.ToString();
}
<div>
    <h1>UPDATE</h1>
    <h3>Edit Produk <strong>@code</strong></h3>
</div>
</div>
<section>
    <form asp-controller="Catalog" asp-action="Edit" asp-route-productCode="@code" method="post" data-validate-form>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div>
            <div>
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name"></span>
            </div>
            <div>
                <label asp-for="Price"></label>
                <input asp-for="Price" type="number" min="0" step="0.01" />
                <span asp-validation-for="Price"></span>
            </div>
            <div>
                <label asp-for="Stock"></label>
                <input asp-for="Stock" type="number" min="0" step="1" />
                <span asp-validation-for="Stock"></span>
            </div>
            <div>
                <label asp-for="Category"></label>
                <input asp-for="Category" />
                <span asp-validation-for="Category"></span>
            </div>
        </div>
        <div>
            <button type="submit">Update</button>
            <a asp-action="Details" asp-route-productCode="@code">Cancel</a>
        </div>
    </form>
</section>

