<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Koda Stores</title>
</head>

<body>
    <header>
        <nav>
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Catalog" asp-action="Index">Catalog</a>
            <a asp-controller="Catalog" asp-action="Create">Add Product</a>
            <a href="/api/v1/products" target="_blank" rel="noopener">JSON API</a>
        </nav>
    </header>

    <main>
        @if (TempData["Success"] is string message)
        {
            <div role="status">@message</div>
        }
        @RenderBody()
    </main>

    <footer>
        <p>Koda Store 2026</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>